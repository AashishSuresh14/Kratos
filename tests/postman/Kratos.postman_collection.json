    {
      "name": "1. Account plan (AC 1, 2)",
      "item": [
        {
          "name": "List my accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAm}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
