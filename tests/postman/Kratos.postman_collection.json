              ],
              "path": [
                "api",
                "v1",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json(); pm.test('scoped list', () => pm.expect(a.length).to.be.above(0));",
                  "pm.collectionVariables.set('accountId', a[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account plan (S1-S12)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAm}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
              "host": [
