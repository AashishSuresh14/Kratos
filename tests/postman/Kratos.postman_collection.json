{
  "info": {
    "name": "Kratos Digital KAM API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Acceptance-criteria walkthrough for the Kratos API. Set baseUrl and password (the demo seed password)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health and auth",
      "item": [
        {
          "name": "Health (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('db ok', () => pm.expect(pm.response.json().db).to.eql('ok'));"
                ]
              }
            }
          ]
        },
