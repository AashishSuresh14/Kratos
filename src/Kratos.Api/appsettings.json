{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Kratos": "Data Source=kratos.db" },
  "Jwt": { "Issuer": "kratos", "Audience": "kratos-web", "LifetimeMinutes": 480 },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "Seed": { "Enabled": true },
  "Scheduler": { "Enabled": true, "SecurityScanMinutes": 15 },
  "Ai": { "DailyTokenBudget": 1500000 },
  "Integrations": { "TeamsWebhookUrl": "" },
  "KeyVault": { "Uri": "" }
}
